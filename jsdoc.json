{
    "recurseDepth": 10,
    "source": {
        "include": ["client", "server"],
        "includePattern": ".+\\.js(doc|x)?$",
        "excludePattern": "(^|\\/|\\\\)_"
    },
    "sourceType": "module",
    "tags": {
        "allowUnknownTags": true,
        "dictionaries": ["jsdoc","closure"]
    },
    "plugins": [
        "plugins/markdown"
    ],
    "templates": {
        "cleverLinks": false,
        "monospaceLinks": false
    },
    "opts": {
		"template": "node_modules/docdash",
        "destination": "docs/api",
        "recurse": true,
        "verbose": true
    },
     "docdash": {
        "search": true,
        "typedefs": true
     }
}